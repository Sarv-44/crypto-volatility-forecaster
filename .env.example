# Environment configuration for Crypto Volatility Forecaster

# Exchange configuration
EXCHANGE_ID=binance
TRADING_PAIR=BTC/USDT
TIMEFRAME=1h
DATA_LIMIT=500

# Sentiment model configuration
SENTIMENT_MODEL=ProsusAI/finbert
CACHE_SENTIMENT=true
BATCH_SIZE=32

# Paths
DATA_RAW_MARKET=data/raw/market
DATA_RAW_SOCIAL=data/raw/social
DATA_PROCESSED=data/processed
MODELS_SAVED=models/saved
